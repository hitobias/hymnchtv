<?xml version="1.0" encoding="utf-8"?>
<!-- Hymn picker (H3, B layout): search, books, preview card, keypad, open, recent. Parts are shared with layout-land, so every id is the same there. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clickable="true"
        android:contentDescription="@string/c_search_hint"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_search"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:hint="@string/c_search_hint"
        android:importantForAutofill="no"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="16sp" />

    <include
        layout="@layout/picker_part_books"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <include
        layout="@layout/picker_part_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <include
        layout="@layout/picker_part_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <include
        layout="@layout/picker_part_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <include
        layout="@layout/picker_part_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
</LinearLayout>

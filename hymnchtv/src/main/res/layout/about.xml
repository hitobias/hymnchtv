<?xml version="1.0" encoding="utf-8"?>
<!-- About (sub-project Z, restyled in spec rev 3 section 5): native views, no WebView, no links, no personal data.
     Icon, name and version on top; the four secondary pages as chips; Check for updates (tonal) above OK (primary). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/hymnchtv" />

        <TextView
            android:id="@+id/about_title"
            style="@style/Hymnal.Dialog.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/about_appVersion"
            style="@style/Hymnal.Dialog.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Version 1.4.0" />

        <TextView
            style="@style/Hymnal.Dialog.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about_description" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/about_help"
                style="@style/Hymnal.Dialog.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help" />
            <com.google.android.material.chip.Chip
                android:id="@+id/about_licenses"
                style="@style/Hymnal.Dialog.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_licenses_title" />
            <com.google.android.material.chip.Chip
                android:id="@+id/history_log"
                style="@style/Hymnal.Dialog.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_history_log" />
            <com.google.android.material.chip.Chip
                android:id="@+id/submit_logs"
                style="@style/Hymnal.Dialog.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_logs" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_new_version"
            style="@style/Hymnal.Dialog.Button.Tonal"
            android:layout_marginTop="20dp"
            android:text="@string/app_update_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ok_button"
            style="@style/Hymnal.Dialog.Button.Primary"
            android:layout_marginTop="8dp"
            android:text="@string/ok" />
    </LinearLayout>
</ScrollView>

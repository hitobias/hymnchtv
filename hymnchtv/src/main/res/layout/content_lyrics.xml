<?xml version="1.0" encoding="utf-8"?>

<!-- Overlay layout (visual redesign 6c): the scrolling lyrics fill the page, the top bar and the three
     buttons float above them and fade away (ChromeController). Scroll padding follows them (LyricsInsets). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <!-- Keeps a slightly diagonal scroll from turning the ViewPager2 page; see NestedScrollableHost -->
    <org.cog.hymnchtv.utils.NestedScrollableHost
        android:id="@+id/lyrics_scroll_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/lyrics_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/lyricsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Up to 5 score pages; hidden as a whole in "lyrics only" (plan A2) -->
            <LinearLayout
                android:id="@+id/scoreContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/contentView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />

                <ImageView
                    android:id="@+id/contentView_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />

                <ImageView
                    android:id="@+id/contentView_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />

                <ImageView
                    android:id="@+id/contentView_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />

                <ImageView
                    android:id="@+id/contentView_d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <!-- Key and time signature from the lyrics header (LyricsMeta); hidden when the file has none -->
            <LinearLayout
                android:id="@+id/lyrics_info_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/meter_key"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Hymnal.Body"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Shown while this hymn is a favourite; the row gravity keeps it at the end when meter_key is gone -->
                <ImageView
                    android:id="@+id/favorite_star"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/fav_marked"
                    android:src="@drawable/ic_sym_star"
                    android:visibility="gone" />
            </LinearLayout>

            <org.cog.hymnchtv.utils.ZoomTextView
                android:id="@+id/lyrics_simplified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.7"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <org.cog.hymnchtv.utils.ZoomTextView
                android:id="@+id/lyrics_traditional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.7"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <WebView
                android:id="@+id/lyrics_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                tools:ignore="WebViewLayout" />
        </LinearLayout>
    </ScrollView>
    </org.cog.hymnchtv.utils.NestedScrollableHost>

    <!-- Transparent landing spot of the hymn number shared element (home to lyrics); ContentView.placeNumberAnchor sizes it over the header number -->
    <View
        android:id="@+id/lyrics_number_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no" />

    <!-- Six buttons at any width (6 x 48dp fits 320dp); A-/A+ moved into the Aa panel, tint into the overflow -->
    <LinearLayout
        android:id="@+id/lyrics_top_bar"
        android:visibility="gone"
        android:accessibilityTraversalBefore="@id/lyrics_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_home"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_sym_home" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_share"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/c_lyrics_share" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_lyrics_media"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/c_lyrics_media" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_aa"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/c_lyrics_aa" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_next"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/c_next_hymn" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_more"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/c_lyrics_more"
            android:src="@drawable/ic_sym_more_vert" />
    </LinearLayout>

    <!-- Same height and style as the top bar buttons; three equal columns, one line each, also at 320dp -->
    <LinearLayout
        android:id="@+id/lyricsButtonBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_ts"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/c_cd_script"
            android:text="@string/c_btn_script" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_english"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/c_cd_cn_en"
            android:text="@string/c_btn_cn_en" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_mode"
            style="@style/LyricsChromeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/c_cd_mode"
            android:text="@string/c_btn_mode_both" />
    </LinearLayout>
</FrameLayout>
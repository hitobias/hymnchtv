<?xml version="1.0" encoding="utf-8"?>
<!-- Home tab: the hymn picker on the user's chosen background. No insets handling here, the host owns the system bars. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Reading-settings background (plan A2); its own view so a photo can be blurred without blurring the keys -->
    <ImageView
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/viewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <include layout="@layout/hymn_picker" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

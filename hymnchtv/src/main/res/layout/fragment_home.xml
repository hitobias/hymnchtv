<?xml version="1.0" encoding="utf-8"?>
<!-- Home page: the hymn picker on the user's chosen background, one screen that does not scroll (HomeScrollView only scrolls in the accessibility exception). The page pads for the navigation bar itself (HomeFragment) so the background reaches the screen edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Reading-settings background (plan A2); its own view so a photo can be blurred without blurring the keys -->
    <ImageView
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <org.cog.hymnchtv.ui.home.HomeScrollView
        android:id="@+id/viewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <include layout="@layout/hymn_picker" />
        </FrameLayout>
    </org.cog.hymnchtv.ui.home.HomeScrollView>
</FrameLayout>

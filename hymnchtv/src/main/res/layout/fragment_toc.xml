<?xml version="1.0" encoding="utf-8"?>
<!-- Contents page: title bar, then choose a hymn book and a kind of index, browse and open a hymn. Colours come from the
     home background through PagePalette (TocFragment.applyPalette). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toc_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <org.cog.hymnchtv.ui.page.PageTitleBar
        android:id="@+id/toc_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:pageTitle="@string/page_title_toc" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/toc_books"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/toc_book_db"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hymn_db"
                android:textAppearance="@style/TextAppearance.Hymnal.Body"
                app:shapeAppearance="@style/ShapeAppearance.Hymnal.Small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/toc_book_bb"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hymn_bb"
                android:textAppearance="@style/TextAppearance.Hymnal.Body"
                app:shapeAppearance="@style/ShapeAppearance.Hymnal.Small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/toc_book_xb"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hymn_xb"
                android:textAppearance="@style/TextAppearance.Hymnal.Body"
                app:shapeAppearance="@style/ShapeAppearance.Hymnal.Small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/toc_book_xg"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hymn_xg"
                android:textAppearance="@style/TextAppearance.Hymnal.Body"
                app:shapeAppearance="@style/ShapeAppearance.Hymnal.Small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/toc_book_yb"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hymn_yb"
                android:textAppearance="@style/TextAppearance.Hymnal.Body"
                app:shapeAppearance="@style/ShapeAppearance.Hymnal.Small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/toc_book_er"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hymn_er"
                android:textAppearance="@style/TextAppearance.Hymnal.Body"
                app:shapeAppearance="@style/ShapeAppearance.Hymnal.Small" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/toc_pages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabTextAppearance="@style/TextAppearance.Hymnal.Body" />

    <FrameLayout
        android:id="@+id/toc_list_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1">

        <ExpandableListView
            android:id="@+id/hymnToc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:groupIndicator="@null" />

        <TextView
            android:id="@+id/toc_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/c_toc_empty"
            android:textAppearance="@style/TextAppearance.Hymnal.Body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/toc_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Home picker, hymn books: two rows of four equal cells (the 8th is the contents button). Checked state is kept in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/booksArea"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/books_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginStart="-3dp"
        android:layout_marginEnd="-3dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_db"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_db" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_bb"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_bb" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_xb"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_xb" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_xg"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_xg" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/books_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginStart="-3dp"
        android:layout_marginEnd="-3dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_yb"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_yb" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_er"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_er" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_english"
            style="@style/Widget.Hymnal.BookButton"
            android:text="@string/c_src_en" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toc"
            style="@style/Widget.Hymnal.BookButton"
            android:checkable="false"
            android:text="@string/c_toc_open"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>

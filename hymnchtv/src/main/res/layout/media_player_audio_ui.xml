<?xml version="1.0" encoding="utf-8"?>

<!-- Lyrics page player card. Colours come from PlayerCardStyle (UiTokens); every control is at least 48dp high and the
     rows hold at 320dp. Rows: title + auto-next, time + progress, repeat + play + speed, media sources. -->
<org.cog.hymnchtv.ui.player.SheetDragLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerUi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- M3 drag handle: 32x4dp, decorative (TalkBack uses the collapse button) -->
    <View
        android:id="@+id/sheet_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/player_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hymn_info"
                style="@style/SmallFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:text="@string/hymn_title_mc_bb"
                android:textColor="?attr/colorOnSurface" />

            <!-- Auto-play the next hymn after this one (was: long-press the play button) -->
            <CheckBox
                android:id="@+id/playback_auto_stream"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="@string/c_auto_stream"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_player_collapse"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/c_player_collapse"
                android:scaleType="center"
                android:src="@drawable/ic_player_expand_more" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playback_position"
                style="@style/TinyFont"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:ignore="HardcodedText" />

            <SeekBar
                android:id="@+id/playback_seekbar"
                style="@android:style/Widget.SeekBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:thumb="@drawable/seekbar_thumb_dark"
                android:thumbOffset="0dp" />

            <TextView
                android:id="@+id/playback_duration"
                style="@style/TinyFont"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="00:00"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Repeat and speed are the same kind of chip, one on each side of the play button -->
        <LinearLayout
            android:id="@+id/mp_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical">

                <LinearLayout
                    android:id="@+id/mp_repeat_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp">

                    <CheckBox
                        android:id="@+id/playback_repeat"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:button="@drawable/ic_player_repeat"
                        android:contentDescription="@string/c_repeat"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="0dp" />

                    <EditText
                        android:id="@+id/repeatCount"
                        android:layout_width="32dp"
                        android:layout_height="48dp"
                        android:autofillHints="no"
                        android:background="@null"
                        android:contentDescription="@string/c_repeat_count"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/playback_play"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/c_play"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_play_arrow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical">

                <Spinner
                    android:id="@+id/playback_speed"
                    android:layout_width="72dp"
                    android:layout_height="48dp"
                    android:entries="@array/mp_speed_name"
                    android:entryValues="@array/mp_speed_value"
                    android:gravity="center"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/media_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</org.cog.hymnchtv.ui.player.SheetDragLinearLayout>

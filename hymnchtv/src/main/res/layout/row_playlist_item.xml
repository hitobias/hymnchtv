<?xml version="1.0" encoding="utf-8"?>
<!-- One hymn of a playlist: drag handle, the hymn and its title, the "Next" mark, remove -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/item_drag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/playlist_reorder"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ic_sym_drag_handle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/item_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Hymnal.Body" />

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Hymnal.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/c_next_hymn"
        android:textAppearance="@style/TextAppearance.Hymnal.Caption"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/item_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_remove_item"
        android:src="@drawable/ic_sym_delete" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog card parts (spec rev 3 section 5). Sizes come from the type scale; colours from colors_dialog.xml. -->
<resources>
    <dimen name="dialog_button_gap_first">20dp</dimen>

    <style name="Hymnal.Dialog.Title" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Hymnal.Heading</item>
        <item name="android:textColor">@color/dialog_on_surface</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Hymnal.Dialog.Body" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Hymnal.Caption</item>
        <item name="android:textColor">@color/dialog_on_surface</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Hymnal.Dialog.Muted" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Hymnal.Caption</item>
        <item name="android:textColor">@color/dialog_on_surface_muted</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Full-width 44dp buttons with 22dp corners; the primary one is filled, the secondary one tonal -->
    <style name="Hymnal.Dialog.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Hymnal.Heading</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="Hymnal.Dialog.Button.Primary">
        <item name="backgroundTint">@color/dialog_primary</item>
        <item name="android:textColor">@color/dialog_on_primary</item>
        <item name="rippleColor">@color/dialog_on_primary</item>
    </style>

    <style name="Hymnal.Dialog.Button.Tonal">
        <item name="backgroundTint">@color/dialog_tonal</item>
        <item name="android:textColor">@color/dialog_on_tonal</item>
        <item name="rippleColor">@color/dialog_on_tonal</item>
    </style>

    <!-- About page links: tonal chips that wrap onto a second line when the card is narrow -->
    <style name="Hymnal.Dialog.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/dialog_tonal</item>
        <item name="android:textColor">@color/dialog_on_tonal</item>
        <item name="android:textAppearance">@style/TextAppearance.Hymnal.Caption</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
</resources>

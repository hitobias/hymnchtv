<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home screen buttons: flat, rounded, coloured in code from the background's UiTokens (HomeTheme) -->
    <style name="Widget.Hymnal.HomeButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Hymn book cell: 44dp, 12dp corners, bold 16sp (shrinks to fit rather than cutting a name off) -->
    <style name="Widget.Hymnal.BookButton" parent="Widget.Hymnal.HomeButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- Keypad key: 14sp corners, bold 26sp digits; the row height is set in code (KeypadMetrics) -->
    <style name="Widget.Hymnal.KeyButton" parent="Widget.Hymnal.HomeButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: left column search, books, preview, recent; right column keypad and open (same ids as the portrait layout) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/tv_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clickable="true"
        android:contentDescription="@string/c_search_hint"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_sym_search"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:hint="@string/c_search_hint"
        android:importantForAutofill="no"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAppearance="@style/TextAppearance.Hymnal.Body" />

        <include
            layout="@layout/picker_part_books"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <include
            layout="@layout/picker_part_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <include
            layout="@layout/picker_part_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include
            layout="@layout/picker_part_keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            layout="@layout/picker_part_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>

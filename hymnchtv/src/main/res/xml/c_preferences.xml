<?xml version="1.0" encoding="utf-8"?>
<!-- Settings tab (sub-project C): everything the old main menu held. Nothing here persists by itself: the fragment shows the
     effective value and applies a change through its change listener (theme and language also need a recreate/restart). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/c_cat_appearance">

        <ListPreference
            app:entries="@array/c_night_modes"
            app:entryValues="@array/c_night_mode_values"
            app:icon="@drawable/ic_sym_palette"
            app:iconSpaceReserved="false"
            app:key="Theme"
            app:persistent="false"
            app:title="@string/theme_menu"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:entries="@array/c_locales"
            app:entryValues="@array/c_locale_values"
            app:icon="@drawable/ic_sym_language"
            app:iconSpaceReserved="false"
            app:key="Locale"
            app:persistent="false"
            app:title="@string/locale_menu"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/c_cat_reading">

        <!-- Lyrics language, fonts, backgrounds, ...: the reading settings screen (plan A2) -->
        <Preference
            app:icon="@drawable/ic_sym_menu_book"
            app:iconSpaceReserved="false"
            app:key="reading_settings"
            app:persistent="false"
            app:title="@string/reading_settings" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/c_cat_media">

        <Preference
            app:icon="@drawable/ic_sym_play_circle"
            app:iconSpaceReserved="false"
            app:key="media_config"
            app:persistent="false"
            app:title="@string/media_config" />
    </PreferenceCategory>

    <!-- D-1 F4: automatic singing log, off until switched on (written to NotebookPrefs through NotebookAsync) -->
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="c_cat_sing_log"
        app:title="@string/c_cat_sing_log">

        <SwitchPreferenceCompat
            app:icon="@drawable/ic_sym_history"
            app:iconSpaceReserved="false"
            app:key="auto_record"
            app:persistent="false"
            app:summary="@string/sing_log_auto_summary"
            app:title="@string/sing_log_auto" />
    </PreferenceCategory>

    <!-- D-1 F3: manual notebook backup through the Storage Access Framework (no storage permission) -->
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="c_cat_backup"
        app:title="@string/c_cat_backup">

        <Preference
            app:icon="@drawable/ic_sym_article"
            app:iconSpaceReserved="false"
            app:key="backup_export"
            app:persistent="false"
            app:summary="@string/backup_export_summary"
            app:title="@string/backup_export" />

        <Preference
            app:icon="@drawable/ic_sym_list"
            app:iconSpaceReserved="false"
            app:key="backup_import"
            app:persistent="false"
            app:summary="@string/backup_import_summary"
            app:title="@string/backup_import" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/c_cat_other">

        <Preference
            app:icon="@drawable/ic_sym_update"
            app:iconSpaceReserved="false"
            app:key="check_update"
            app:persistent="false"
            app:title="@string/c_check_update" />

        <Preference
            app:icon="@drawable/ic_sym_lock"
            app:iconSpaceReserved="false"
            app:key="permission_request"
            app:persistent="false"
            app:title="@string/permission_settings" />

        <Preference
            app:icon="@drawable/ic_sym_help"
            app:iconSpaceReserved="false"
            app:key="online_help"
            app:persistent="false"
            app:title="@string/help_online" />

        <Preference
            app:icon="@drawable/ic_sym_info"
            app:iconSpaceReserved="false"
            app:key="about"
            app:persistent="false"
            app:title="@string/about" />
    </PreferenceCategory>
</PreferenceScreen>
